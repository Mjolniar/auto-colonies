# Colony Autopilot defaults (Jonah's Colony Manager). Read once, when a save first creates its Colony Autopilot settings.
# Everything here can be changed in-game: Intel screen > Colonies > Colony Autopilot > Settings.
{
	# Budget
	"budgetPercentMode":true,      # true: a share of net income; false: the fixed amount below
	"budgetPercent":0.5,           # share of last month's net income spent per month
	"budgetFixed":1000000,
	"perProjectCap":2000000,       # bigger projects wait for you
	"reserve":500000,              # never spends your credits below this
	"terraformShare":0.4,          # most of the monthly budget terraforming may use
	"newUpkeepCap":50000,          # most new monthly upkeep added per month
	"pauseOnLoss":true,            # no spending while net income is negative
	"feeLevel":2,                  # convenience fees: 0 off, 1 low, 2 standard, 3 high

	# Building and planning
	"stationLine":"score",         # score, low, mid, high
	"allowRemovals":false,         # removals outside terraforming
	"storyPointRule":0,            # 0 player only, 1 one per colony, 2 monthly cap
	"storyPointMonthlyCap":2,

	# Items and AI cores (only from Autopilot Storage)
	"useAICores":false,
	"alphaMode":0,                 # 0 only where removable, 1 anywhere, 2 never

	# Administrators
	"adminHiring":false,
	"adminOptimal":true,           # place idle administrators first
	"adminDelay":true,             # 30-day arrival delay for hired administrators and ambassadors

	# Ambassadors (Industrial Evolution)
	"ambassadorFocus":0,           # 0 worst relations first, 1 strongest factions, 2 nearest neighbors, 3 priority list only
	"ambassadorStopAt":2,          # stop raising a faction at: 0 Welcoming, 1 Friendly, 2 Cooperative, 3 never
	"factionPriority":{},          # e.g. {"hegemony":2, "pirates":0}: 2 high, 1 normal, 0 ignore

	# Colony policies
	"hazardPayMode":0,             # 0 auto, 1 don't touch
	"hazardPayColonyShare":0.25,
	"hazardPayEmpireShare":0.10,
	"freePortMode":0,

	# Stability floor the manager never builds below
	"minStability":5,
}
